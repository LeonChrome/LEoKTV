{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LEoKTV",
  "version": "0.1.13",
  "identifier": "com.leoktv.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LEoKTV",
        "width": 1440,
        "height": 900,
        "minWidth": 360,
        "minHeight": 620,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' blob: data:; connect-src 'self' blob: https://api.github.com https://github.com; media-src 'self' blob: data: http://asset.localhost https://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "externalBin": ["binaries/mdx-worker"],
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
